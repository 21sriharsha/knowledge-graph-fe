# -----------------------------------------------------------------------------------------------
# Non-production (Vercel "Preview" + staging). NON-SECRET values only — this file is committed.
# Secrets (marked SECRET in .env.example) are set in the Vercel project, never here.
# Local use:  pnpm build:nonprod   (loads this file via node --env-file)
# Fill the TODO hosts once the staging projects exist (release plan W0, T-W0-08).
# -----------------------------------------------------------------------------------------------
APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging

# TODO(W0): Fly.io staging backend, e.g. https://kg-be-staging.fly.dev
API_BASE_URL=https://kg-be-staging.fly.dev
API_TIMEOUT_READ_MS=5000
API_TIMEOUT_WRITE_MS=10000

# TODO(W0): Vercel staging domain
NEXT_PUBLIC_SITE_URL=https://staging.knowledge-graph.example
NEXT_PUBLIC_WEBHOOK_BASE_URL=https://kg-be-staging.fly.dev

AUTH_MODE=supabase
NEXT_PUBLIC_AUTH_MODE=supabase
# TODO(W0): Supabase staging project (publishable key is public by design)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET — set in Vercel: REVALIDATE_SECRET, SENTRY_AUTH_TOKEN
REVALIDATE_SECRET=

TELEMETRY_EXPORTER=sentry
NEXT_PUBLIC_TELEMETRY_EXPORTER=sentry
# TODO(W0): Sentry DSN (not secret)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
TELEMETRY_TRACES_SAMPLE_RATE=1
NEXT_PUBLIC_TELEMETRY_TRACES_SAMPLE_RATE=1
LOG_LEVEL=info

FEATURE_SEARCH=true
FEATURE_EXPLORER=true
FEATURE_STUDIO=true
