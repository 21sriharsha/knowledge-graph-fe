{
  "name": "knowledge-graph-fe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:nonprod": "node --env-file=.env.nonprod ./node_modules/next/dist/bin/next build",
    "build:prod": "node --env-file=.env.prod ./node_modules/next/dist/bin/next build",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:types": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm api:check"
  },
  "dependencies": {
    "@oddbird/popover-polyfill": "^0.7.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@sentry/nextjs": "^11.18.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "@vercel/otel": "^2.3.0",
    "d3-drag": "^3.0.1",
    "d3-force": "^3.0.1",
    "d3-selection": "^3.0.1",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "interestfor": "1.0.14",
    "invokers-polyfill": "^1.0.5",
    "mermaid": "^12.3.0",
    "next": "16.4.6",
    "openapi-fetch": "^0.17.0",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-aria": "^3.53.1",
    "react-dom": "19.3.0",
    "react-stately": "3.51.0",
    "server-only": "^0.0.1",
    "shiki": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.22.0"
}
