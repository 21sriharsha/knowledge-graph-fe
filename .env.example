# -----------------------------------------------------------------------------------------------
# knowledge-graph-fe — environment template (local development)
#
# Copy to .env.local and fill the secrets:   cp .env.example .env.local
# Every variable is validated at startup by src/lib/env/schema.ts (zod); invalid values fail fast
# with the variable name only (values are never printed).
#
# Files:
#   .env.example  this file: every variable, documented, local defaults (committed)
#   .env.nonprod  non-secret values for preview + staging (committed; secrets set in Vercel)
#   .env.prod     non-secret values for production (committed; secrets set in Vercel)
#   .env.local    your real local values (git-ignored)
# -----------------------------------------------------------------------------------------------

# --- Environment -------------------------------------------------------------------------------
# local | test | preview | staging | production
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
# Shown in telemetry; CI sets it to the git SHA.
NEXT_PUBLIC_RELEASE=dev

# --- Backend (server-only; the browser never sees it — ADR 0002) -------------------------------
API_BASE_URL=http://localhost:8080
API_TIMEOUT_READ_MS=5000
API_TIMEOUT_WRITE_MS=10000

# --- Public URLs -------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public base URL of the backend, shown to admins as the webhook target when connecting a repo.
NEXT_PUBLIC_WEBHOOK_BASE_URL=http://localhost:8080

# --- Authentication ----------------------------------------------------------------------------
# supabase: real OIDC sign-in (required everywhere except local/test).
# dev:      local-only persona sign-in mapped to the backend's HTTP Basic users. Refused by the
#           env schema unless APP_ENV is local or test.
AUTH_MODE=dev
NEXT_PUBLIC_AUTH_MODE=dev
# HMAC key for the dev session cookie: 32+ random chars, e.g. `openssl rand -hex 32`. SECRET.
DEV_AUTH_SECRET=
# Backend local profile users (see knowledge-graph-be README). user:password.
DEV_AUTH_AUTHOR_CREDENTIALS=author:author
DEV_AUTH_ADMIN_CREDENTIALS=admin:admin
# Supabase project (only for AUTH_MODE=supabase). The publishable key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Cache revalidation webhook (backend -> POST /api/revalidate) ------------------------------
# Shared HMAC secret, 32+ random chars. SECRET. Must match the backend's configuration (BG-1).
REVALIDATE_SECRET=

# --- Telemetry (ADR 0005) ----------------------------------------------------------------------
# sentry | otlp | none
TELEMETRY_EXPORTER=none
NEXT_PUBLIC_TELEMETRY_EXPORTER=none
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source map upload. SECRET.
SENTRY_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
TELEMETRY_TRACES_SAMPLE_RATE=1
NEXT_PUBLIC_TELEMETRY_TRACES_SAMPLE_RATE=1
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- Feature flags (server-side; flagged-off routes return 404) --------------------------------
FEATURE_SEARCH=true
FEATURE_EXPLORER=true
FEATURE_STUDIO=true
