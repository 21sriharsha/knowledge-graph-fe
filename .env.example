# The Spring Boot backend. Server-side only; never exposed to the browser, so the backend needs no
# public ingress -- expose only this frontend and keep the API on a private network.
#
# Required in production. There is no fallback there: the frontend and backend are separate
# deployments, and guessing localhost would make every page report an outage that is really a
# missing variable.
KNOWLEDGE_API_URL=http://localhost:8080

# How long to wait for the backend before rendering the "backend unavailable" state. Every public
# page is server-rendered, so an unbounded wait is a page render that never finishes.
KNOWLEDGE_API_TIMEOUT_MS=8000

# Studio credentials. Attached to /api/studio calls server-side, so they never reach the client.
# Match knowledge.security.studio-users in the backend's configuration.
KNOWLEDGE_STUDIO_USERNAME=author
KNOWLEDGE_STUDIO_PASSWORD=author

# ── Identity ────────────────────────────────────────────────────────────────
# Supabase Auth. Both values below are public by design: the publishable key is meant for the
# browser and is bounded by row-level security. The service-role key bypasses RLS entirely and must
# never appear in this application.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Social providers to offer on the sign-in page. Each must also be enabled in the Supabase
# dashboard -- a button for a provider that is not enabled leads to an error page.
# Supported: google, azure (Microsoft), discord, github
NEXT_PUBLIC_AUTH_PROVIDERS=

# Password rules are enforced by Supabase, not here:
#   Authentication -> Sign In / Providers -> Email
# src/lib/password-policy.ts mirrors them so the form can show the rules before a rejection.
# Where the two disagree the provider wins.

# Studio credentials are now a fallback for non-human callers only (CI, scripts). A signed-in
# person's own token is used instead. Leave unset unless something without a browser needs access.
