# -----------------------------------------------------------------------------------------------
# Production (Vercel "Production"). NON-SECRET values only — this file is committed.
# Secrets (marked SECRET in .env.example) are set in the Vercel project, never here.
# Local use:  pnpm build:prod   (loads this file via node --env-file)
# Fill the TODO hosts once the production projects exist (release plan W0, T-W0-08).
# -----------------------------------------------------------------------------------------------
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production

# TODO(W0): Fly.io production backend
API_BASE_URL=https://kg-be-prod.fly.dev
API_TIMEOUT_READ_MS=5000
API_TIMEOUT_WRITE_MS=10000

# TODO(W0): production domain
NEXT_PUBLIC_SITE_URL=https://knowledge-graph.example
NEXT_PUBLIC_WEBHOOK_BASE_URL=https://kg-be-prod.fly.dev

AUTH_MODE=supabase
NEXT_PUBLIC_AUTH_MODE=supabase
# TODO(W0): Supabase production project (publishable key is public by design)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET — set in Vercel: REVALIDATE_SECRET, SENTRY_AUTH_TOKEN
REVALIDATE_SECRET=

TELEMETRY_EXPORTER=sentry
NEXT_PUBLIC_TELEMETRY_EXPORTER=sentry
# TODO(W0): Sentry DSN (not secret)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
TELEMETRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_TELEMETRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info

# Waves not yet released stay off in production until their exit criteria pass (release plan).
FEATURE_SEARCH=false
FEATURE_EXPLORER=false
FEATURE_STUDIO=false
